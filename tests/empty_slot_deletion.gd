extends RefCounted

const Tools := preload("res://tests/building_tools.gd")

static func run(tree: SceneTree, game: Node3D, check: Callable) -> void:
	var builder: ClassicalBuilder = game.builder
	var player: BuilderPlayer = game.player
	game.ui.enter_world()
	player.set_flying(true)
	builder.clear_hotbar()
	for slot in range(BuildCatalogue.BUILD_SLOTS):
		var records := [Tools.record("foundation",Vector3(12,0,0))]
		builder.restore(records)
		builder.select_slot(slot)
		player.position = Vector3(12,1,7)
		player.look_at_point(Vector3(12,0.2,0))
		await Tools.settle(tree)
		check.call(builder.is_empty_handed() and builder.target == builder.pieces[0] and builder.outline.visible and not builder.marker.visible and not is_instance_valid(builder.ghost),"Empty slot %d highlights the aimed component without a placement ghost" % (slot+1))
		await Tools.mouse(tree,MOUSE_BUTTON_LEFT)
		check.call(builder.serialize() == records and builder.history.is_empty(),"Left-click with empty hands cannot place or delete a component")
		await Tools.mouse(tree,MOUSE_BUTTON_RIGHT)
		check.call(builder.pieces.is_empty() and builder.history.size() == 1 and builder.dirty,"Right-click with empty slot %d removes the aimed component" % (slot+1))
		await Tools.key(tree,KEY_Z,true)
		check.call(builder.serialize() == records,"Empty-handed deletion supports Ctrl+Z undo")
		await Tools.key(tree,KEY_Y,true)
		check.call(builder.pieces.is_empty(),"Empty-handed deletion supports Ctrl+Y redo")
	# A click refreshes the ray even if the camera moved since the last physics preview.
	builder.restore([Tools.record("foundation",Vector3(12,0,0)),Tools.record("foundation",Vector3(20,0,0),2)])
	player.position = Vector3(16,2,9)
	player.look_at_point(Vector3(12,0.2,0))
	await Tools.settle(tree)
	check.call(builder.target == builder.pieces[0],"The first component receives the empty-handed hover outline")
	player.look_at_point(Vector3(20,0.2,0))
	builder.demolish()
	check.call(builder.pieces.size() == 1 and builder.pieces[0].uid == 1,"Deletion rechecks the current camera aim rather than removing a stale hover target")
	player.look_at_point(player.camera.global_position+Vector3.UP*10)
	await Tools.settle(tree)
	await Tools.mouse(tree,MOUSE_BUTTON_RIGHT)
	check.call(builder.pieces.size() == 1 and builder.target == null and not builder.outline.visible,"Looking away clears the outline and right-click on sky does nothing")
	player.position = Vector3(12,1,30)
	player.look_at_point(Vector3(12,0.2,0))
	await Tools.settle(tree)
	await Tools.mouse(tree,MOUSE_BUTTON_RIGHT)
	check.call(builder.pieces.size() == 1 and builder.target == null,"Empty-handed deletion respects building reach")
	# A first-hit blocker receives the outline and deletion; it cannot delete through to a peer.
	builder.restore([Tools.record("foundation_podium",Vector3(12,0,4),1),Tools.record("foundation_podium",Vector3(12,0,-2),2)])
	player.position = Vector3(12,1,10)
	player.look_at_point(Vector3(12,1,0))
	await Tools.settle(tree)
	await Tools.mouse(tree,MOUSE_BUTTON_RIGHT)
	check.call(builder.pieces.size() == 1 and builder.pieces[0].uid == 2,"Empty-handed deletion removes the first aimed solid, not the component behind it")
	player.position = Vector3(12,1,5)
	player.look_at_point(Vector3(12,1,-2))
	await Tools.settle(tree)
	game.ui.show_catalogue()
	builder.demolish()
	await Tools.mouse(tree,MOUSE_BUTTON_RIGHT)
	check.call(builder.pieces.size() == 1,"An open library blocks empty-handed world deletion")
	game.ui.show_menu()
	builder.demolish()
	await Tools.mouse(tree,MOUSE_BUTTON_RIGHT)
	check.call(builder.pieces.size() == 1,"A paused game blocks empty-handed world deletion")
	game.ui.enter_world()
	builder.select_slot(BuildCatalogue.TOOL_SLOT)
	await Tools.settle(tree)
	await Tools.mouse(tree,MOUSE_BUTTON_RIGHT)
	check.call(builder.pieces.size() == 1 and not builder.is_stacking(),"Right-click with the idle Stack tool remains reserved for selection")
	builder.restore([])
	builder.hotbar = BuildCatalogue.HOTBAR.duplicate()
	builder.select_slot(BuildCatalogue.DEFAULT_SLOT)
	game.ui.show_menu()
