extends RefCounted

const Tools := preload("res://tests/building_tools.gd")
const Frames := preload("res://tests/flight_momentum.gd")

static func event(pressed: bool, echo: bool = false, code: Key = KEY_W) -> InputEventKey:
	var key := InputEventKey.new()
	key.keycode = code
	key.physical_keycode = code
	key.pressed = pressed
	key.echo = echo
	return key

static func tap(player: BuilderPlayer, at: int) -> void:
	player.handle_sprint_input(event(true),at)
	player.handle_sprint_input(event(false),at+20)

static func run(tree: SceneTree, game: Node3D, check: Callable) -> void:
	var player: BuilderPlayer = game.player
	game.builder.restore([])
	game.ui.enter_world()
	player.set_physics_process(false)
	player.set_flying(false)
	tap(player,1000)
	player.handle_sprint_input(event(true),1200)
	check.call(player.sprinting,"Two W presses within 300 ms activate sprint while the second press is held")
	player.handle_sprint_input(event(false),1250)
	check.call(not player.sprinting,"Releasing W immediately ends the latched sprint")
	player.handle_sprint_input(event(true),1300)
	check.call(not player.sprinting,"The second W press consumes its pair so a third press starts a fresh gesture")
	player.reset_sprint_taps()
	player.handle_sprint_input(event(true),2000)
	player.handle_sprint_input(event(true,true),2050)
	player.handle_sprint_input(event(true),2100)
	check.call(not player.sprinting,"Keyboard repeat and duplicate presses without a release never activate sprint")
	player.reset_sprint_taps()
	tap(player,3000)
	player.handle_sprint_input(event(true),3301)
	check.call(not player.sprinting,"W presses more than 300 ms apart keep normal movement")
	player.reset_sprint_taps()
	tap(player,4000)
	player.handle_sprint_input(event(true),4300)
	check.call(player.sprinting,"The 300 ms sprint gesture boundary is inclusive")
	player.handle_sprint_input(event(true,false,KEY_S),4310)
	check.call(not player.sprinting,"Pressing backwards cancels a forward sprint")
	player.reset_sprint_taps()
	tap(player,5000)
	game.ui.show_catalogue()
	game.ui.close_overlay()
	player.handle_sprint_input(event(true),5100)
	check.call(not player.sprinting,"A partial W gesture cannot cross a library pause")
	player.reset_sprint_taps()
	tap(player,6000)
	player.handle_sprint_input(event(true),6100)
	game.ui.show_menu()
	check.call(not player.sprinting,"Opening a menu clears an active sprint")
	game.ui.enter_world()
	player.reset_sprint_taps()
	tap(player,7000)
	player.handle_sprint_input(event(true),7100)
	player.notification(Node.NOTIFICATION_APPLICATION_FOCUS_OUT)
	check.call(not player.sprinting,"Losing application focus clears sprint state")
	player.reset_sprint_taps()
	tap(player,8000)
	player.handle_sprint_input(event(true),8100)
	player.set_flying(true)
	check.call(not player.sprinting,"Changing flight mode clears old sprint gestures")
	# Deterministic speed/normalization checks use real movement actions.
	Input.action_press("forward")
	player.set_flying(false)
	player.rotation.y = 0
	player.position = Vector3(30,4,30)
	for i in range(20): player._physics_process(1.0/60)
	check.call(is_equal_approx(Vector2(player.velocity.x,player.velocity.z).length(),10),"Normal forward walking still reaches 10 m/s")
	tap(player,9000)
	player.handle_sprint_input(event(true),9100)
	for i in range(20): player._physics_process(1.0/60)
	check.call(is_equal_approx(Vector2(player.velocity.x,player.velocity.z).length(),18),"Holding the second W press accelerates walking to 18 m/s")
	Input.action_press("right")
	for i in range(20): player._physics_process(1.0/60)
	check.call(is_equal_approx(Vector2(player.velocity.x,player.velocity.z).length(),18),"Diagonal sprint has the same total speed as straight sprint")
	Input.action_release("right")
	Input.action_release("forward")
	for i in range(20): player._physics_process(1.0/60)
	check.call(not player.sprinting and Vector2(player.velocity.x,player.velocity.z).is_zero_approx(),"Releasing the actual forward action stops sprinting and movement")
	Input.action_press("forward")
	Input.action_press("sprint")
	for i in range(20): player._physics_process(1.0/60)
	check.call(is_equal_approx(Vector2(player.velocity.x,player.velocity.z).length(),18),"Holding Shift still sprints on foot")
	Input.action_release("sprint")
	player.set_flying(true)
	player.position = Vector3(30,15,30)
	tap(player,10000)
	player.handle_sprint_input(event(true),10100)
	for i in range(20): player._physics_process(1.0/60)
	check.call(is_equal_approx(player.velocity.length(),28.8),"Double-tap W also gives faster forward flight")
	Input.action_press("descend")
	for i in range(20): player._physics_process(1.0/60)
	check.call(player.velocity.y < 0 and is_equal_approx(player.velocity.length(),28.8),"Shift continues to descend during fast flight without multiplying diagonal speed")
	Input.action_release("descend")
	Input.action_release("forward")
	player.reset_sprint_taps()
	player.set_physics_process(true)
	# Native W events must reach the player even with an empty hotbar slot.
	game.builder.clear_slot(8)
	game.builder.select_slot(8)
	player.set_flying(true)
	player.position = Vector3(30,15,30)
	await Tools.key(tree,KEY_W)
	Input.parse_input_event(event(true))
	await Frames.frames(tree,18)
	check.call(player.sprinting and is_equal_approx(player.velocity.length(),28.8),"Native W double-tap-and-hold input activates sprint with empty hands")
	Input.parse_input_event(event(false))
	await Frames.frames(tree,35)
	check.call(not player.sprinting and player.velocity.is_zero_approx(),"Native W release stops sprint and flight momentum settles normally")
	game.builder.hotbar = BuildCatalogue.HOTBAR.duplicate()
	game.builder.select_slot(BuildCatalogue.DEFAULT_SLOT)
	game.ui.show_menu()
