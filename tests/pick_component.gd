extends RefCounted

const Tools := preload("res://tests/building_tools.gd")

static func run(tree: SceneTree, game: Node3D, check: Callable) -> void:
	var builder: ClassicalBuilder = game.builder
	var player: BuilderPlayer = game.player
	game.ui.enter_world()
	player.set_flying(true)
	builder.hotbar = BuildCatalogue.HOTBAR.duplicate()
	builder.restore([Tools.record("doric_column",Vector3(12,0,0),1,0,2)])
	await Tools.aim(tree,game,builder.pieces[0])
	builder.select_slot(3)
	var bar := builder.hotbar.duplicate()
	var world := builder.serialize()
	await Tools.mouse(tree,MOUSE_BUTTON_MIDDLE)
	check.call(builder.selected_slot == 1 and builder.hotbar == bar,"Middle-click selects an existing matching hotbar component without replacing any slot")
	check.call(builder.stone == 2 and builder.ghost.stone == 2,"Picking also equips the aimed component's stone finish")
	check.call(builder.serialize() == world and builder.history.is_empty(),"Middle-click never changes the building or its undo history")
	builder.assign_slot(3,"doric_column")
	builder.select_slot(3)
	await Tools.mouse(tree,MOUSE_BUTTON_MIDDLE)
	check.call(builder.selected_slot == 3,"Picking an already equipped duplicate keeps the current matching slot")
	builder.restore([Tools.record("horse_relief",Vector3(12,0,0))])
	await Tools.aim(tree,game,builder.pieces[0])
	builder.select_slot(4)
	bar = builder.hotbar.duplicate()
	await Tools.mouse(tree,MOUSE_BUTTON_MIDDLE)
	bar[4] = "horse_relief"
	check.call(builder.hotbar == bar and builder.selected_slot == 4 and builder.ghost.kind == "horse_relief" and builder.dirty,"A missing component replaces only the currently selected building slot")
	builder.restore([Tools.record("urn",Vector3(12,0,0))])
	await Tools.aim(tree,game,builder.pieces[0])
	builder.clear_slot(8)
	builder.select_slot(8)
	await Tools.mouse(tree,MOUSE_BUTTON_MIDDLE)
	check.call(builder.hotbar[8] == "urn" and builder.selected_slot == 8 and is_instance_valid(builder.ghost),"Middle-click fills an empty selected slot")
	game.save_world()
	builder.clear_slot(8)
	game.load_world()
	check.call(builder.hotbar[8] == "urn" and builder.selected_slot == 8,"Picked hotbar assignments and selection survive save/load")
	# The fixed Stack tool is never overwritten; its remembered editable slot is used.
	builder.restore([Tools.record("pediment_crown",Vector3(12,0,0))])
	await Tools.aim(tree,game,builder.pieces[0])
	builder.select_slot(6)
	builder.select_slot(BuildCatalogue.TOOL_SLOT)
	await Tools.mouse(tree,MOUSE_BUTTON_MIDDLE)
	check.call(builder.selected_slot == 6 and builder.hotbar[6] == "pediment_crown" and builder.hotbar[BuildCatalogue.TOOL_SLOT] == BuildCatalogue.TOOL_KIND,"Picking from Stack uses the previous building slot and preserves the fixed tool")
	builder.select_slot(BuildCatalogue.TOOL_SLOT)
	await Tools.mouse(tree,MOUSE_BUTTON_LEFT)
	check.call(builder.is_stacking(),"The pick test starts a live stack selection")
	await Tools.mouse(tree,MOUSE_BUTTON_MIDDLE)
	check.call(not builder.is_stacking() and builder.selected_slot == 6 and not builder.stack_hover_outline.visible,"Middle-click switches from a live stack selection to its picked component cleanly")
	player.look_at_point(player.camera.global_position+Vector3.UP*10)
	bar = builder.hotbar.duplicate()
	var slot := builder.selected_slot
	await Tools.mouse(tree,MOUSE_BUTTON_MIDDLE)
	check.call(builder.hotbar == bar and builder.selected_slot == slot,"Picking the sky leaves the hotbar unchanged")
	player.position = Vector3(12,1,30)
	player.look_at_point(Vector3(12,0.6,0))
	await Tools.settle(tree)
	await Tools.mouse(tree,MOUSE_BUTTON_MIDDLE)
	check.call(builder.hotbar == bar and builder.selected_slot == slot,"Middle-click respects the player's reach")
	# Recheck the current aim rather than using the previous hovered component.
	builder.restore([Tools.record("doric_column",Vector3(12,0,0)),Tools.record("ionic_column",Vector3(20,0,0),2)])
	player.position = Vector3(16,2,9)
	player.look_at_point(Vector3(12,2,0))
	await Tools.settle(tree)
	player.look_at_point(Vector3(20,2,0))
	builder.pick_aimed_component()
	check.call(builder.selected_kind() == "ionic_column","Middle-click uses a fresh camera ray after the player changes aim")
	game.ui.show_catalogue()
	bar = builder.hotbar.duplicate()
	check.call(not builder.pick_aimed_component() and builder.hotbar == bar,"The library blocks world picking")
	game.ui.show_menu()
	check.call(not builder.pick_aimed_component() and builder.hotbar == bar,"A paused game blocks world picking")
	builder.hotbar = BuildCatalogue.HOTBAR.duplicate()
	builder.select_slot(BuildCatalogue.DEFAULT_SLOT)
	builder.restore([])
